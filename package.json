{
  "name": "project-validator-web",
  "private": true,
  "description": "The JavaScript of the validator's browser page and HTML report: its tools and tests",
  "license": "Unlicense",
  "scripts": {
    "format": "prettier --check \"web/*.js\" \"project_validator/views/assets/*.js\" \"tests/web/*.{mjs,cjs}\" \"*.mjs\"",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "c8 --check-coverage --branches 100 --lines 100 --all --include \"web/*.js\" --include \"project_validator/views/assets/*.js\" node --test \"tests/web/*.test.mjs\"",
    "test:browsers": "playwright test",
    "fuzz": "jazzer tests/web/repository.fuzz.cjs --sync -- -max_total_time=60",
    "mutate": "stryker run --incremental"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jazzer.js/core": "4.0.0",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "c8": "12.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "qs": "6.17.1"
  }
}
