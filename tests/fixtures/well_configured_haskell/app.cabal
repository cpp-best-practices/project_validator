cabal-version: 3.0
name:          app
version:       0.1.0
license:       MIT
license-file:  LICENSE

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wredundant-constraints
  if flag(pedantic)
    ghc-options: -Werror

flag pedantic
  description: Treat warnings as errors
  default:     False
  manual:      True

library
  import:           warnings
  exposed-modules:  App
  hs-source-dirs:   src
  build-depends:    base >=4.18 && <5
  default-language: GHC2021

executable app
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base, app
  default-language: GHC2021

test-suite spec
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base, app
  default-language: GHC2021
